<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thejoa703.dao.UserDao">
	  <!-- 명시적 매핑 -->
	  <resultMap id="userMap" type="UserVO">
	    <result property="id" 		  column="ID"/>
	    <result property="appUserId"  column="APP_USER_ID"/>
	    <result property="email"      column="EMAIL"/>
	    <result property="password"   column="PASSWORD"/>
	    <result property="mbtiTypeId" column="MBTI_TYPE_ID"/>
	    <result property="createdAt"  column="CREATED_AT"/>
	  </resultMap>
	<insert id="insert"  parameterType="UserVO">
		insert into appuser (APP_USER_ID ,PASSWORD,  EMAIL, MBTI_TYPE_ID) 
		values ( appuser_seq.nextval, #{password} ,#{email} , #{mbtiTypeId})
	</insert>
	<select id="select"    parameterType="int"  resultMap ="userMap"   >
		select * from appuser where APP_USER_ID=#{appUserId}
	</select>
	<select id="selectAll"  resultMap ="userMap" >
		select * from appuser order by APP_USER_ID desc
	</select>
	<update id="update"  parameterType="UserVO">
		update appuser set email=#{email} , MBTI_TYPE_ID=#{mbtiTypeId} where  APP_USER_ID=#{appUserId}
	</update>
	<delete id="delete"  parameterType="int">
		delete from appuser where APP_USER_ID=#{appUserId}
	</delete>
</mapper>